    "n-nyISan": {
      "type": "text",
      "data": {
        "text": "<span class=\"sm-text-color-1f73af\">Single Family Hillside &amp; Coastal Overlay Zone Feedback</span>",
        "type": "h3"
      }
    },
    "n-OTPIHt": {
      "type": "embed",
      "data": {
        "url": "https://youtu.be/O176F_as8Es?si=VXTneciwTSVsZiZ4",
        "embedType": "video",
        "title": "Share Your Feedback on Objective Design Standards",
        "description": "The City is gathering community feedback as it explores objective development standards for single-family-zoned properties. The discussion forum is open until August 30. To learn more about the project and submit your comment, visit TorranceCA.Gov/ObjectiveDesignStandards. #TorranceCA",
        "thumbnailUrl": "https://i.ytimg.com/vi/O176F_as8Es/hqdefault.jpg",
        "providerUrl": "https://www.youtube.com/",
        "height": 480,
        "width": 854,
        "caption": "Share Your Feedback on Objective Design Standards",
        "isEmbedSupported": true,
        "display": "inline",
        "embedSrc": "https://cdn.embedly.com/widgets/media.html?a=0&src=https%3A%2F%2Fwww.youtube.com%2Fembed%2FO176F_as8Es%3Ffeature%3Doembed&display_name=YouTube&url=https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3DO176F_as8Es&image=https%3A%2F%2Fi.ytimg.com%2Fvi%2FO176F_as8Es%2Fhqdefault.jpg&type=text%2Fhtml&schema=youtube",
        "aspectRatio": 1.7778
      },
      "config": {
        "size": "wide"
      }
    },
    "n-rr1fd3": {
      "type": "text",
      "data": {
        "type": "paragraph",
        "text": "The City of Torrance is seeking community input on objective development standards for properties located within the Single-Family Residential (R-1) and Hillside and Coastal Overlay (R-H) Zones."
      }
    },
    "n-TzjMbM": {
      "type": "text",
      "data": {
        "type": "paragraph",
        "text": "This outreach effort was initiated in response to City Council direction provided during the May 19, 2026, public workshop regarding the Hillside Overlay Zone. As discussed during the workshop, the existing development standards for the Hillside and Coastal Overlay Zone remain an important consideration as the City evaluates potential updates."
      }
    },
    "n-jsGTKT": {
      "type": "text",
      "data": {
        "type": "paragraph",
        "text": "<span>Community comments submitted through this process will assist City staff in evaluating potential objective development standards and related procedures for future discussions and consideration by the City Council.</span>"
      }
    },
    "n-KTs7hO": {
      "type": "text",
      "data": {
        "type": "paragraph",
        "text": "<span>To view the full workshop replay, please visit the May 19, 2026, City Council meeting on YouTube through Torrance Citi Cable.</span>"
      }
    },
    "n-9EGdZT": {
      "type": "text",
      "data": {
        "type": "paragraph",
        "text": "<span>The discussion forum will remain open through August 30, 2026. Community members are encouraged to share their feedback and participate in this important conversation.&nbsp; To learn more about the project and submit your comments, visit <a href=\"https://torranceca.gov/ObjectiveDesignStandards\">https://torranceca.gov/ObjectiveDesignStandards</a>. </span>"
      }
    },
    "n-uIcNfu": {
      "type": "text",
      "data": {
        "type": "paragraph",
        "text": "\u00a0"
      }
    },
